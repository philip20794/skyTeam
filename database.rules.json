{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$roomId": {
        "public": {
          ".read": "auth != null && data.child('members').child(auth.uid).exists()",
          ".write": false
        },
        "privateDice": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid && root.child('rooms').child($roomId).child('public').child('members').child(auth.uid).exists()",
            ".write": false
          }
        }
      }
    },
    "userRooms": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "presence": {
      "$roomId": {
        "$uid": {
          ".read": "auth != null && root.child('rooms').child($roomId).child('public').child('members').child(auth.uid).exists()",
          ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($roomId).child('public').child('members').child(auth.uid).exists()",
          ".validate": "newData.hasChildren(['connected', 'lastSeen']) && newData.child('connected').isBoolean() && newData.child('lastSeen').isNumber()"
        }
      }
    },
    "roomCodes": {
      ".read": false,
      ".write": false
    },
    "rateLimits": {
      ".read": false,
      ".write": false
    }
  }
}
